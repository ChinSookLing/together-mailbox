diff --git a/dispatcher/jobs/k11-p509a.sh b/dispatcher/jobs/k11-p509a.sh
new file mode 100644
index 0000000..e5573fd
--- /dev/null
+++ b/dispatcher/jobs/k11-p509a.sh
@@ -0,0 +1,53 @@
+# Job k11-p509a (Opus chair note 128 spec: prime 509, 751 jobs / 31 roots per chair list PT005/opus/joblists/p509-jobs.txt; start by hand, K11 idle since the previous job DONE 2026-11-06 15:53:50 +08): first run of p = 509, BUDGET 2026-11-11 18:00 +08. Copy of the previous K11 job with prime, paths and BUDGET changed; job count is read from kcascade_run.py's own 'ir jobs N' line (no hand-typed count). Start by hand; no chain.
+# Build once with jobs/kit/setup_k15.sh (sha256 602b6f99...), then kcascade_run.py (sha256 90632d55...) with 16 workers.
+# First start: BUDGET stops new jobs at 2026-11-11 18:00 +08. Any start after that runs with no BUDGET.
+# Restart-safe: kcascade_run.py skips jobs already in out509/ir.jsonl.
+set +x
+set -uo pipefail
+OUT=/tmp
+source "${HOME}/k11-gate/dispatcher/gates/lib.sh"
+N=k11-p509a; W="$WORK/$N"; CK="$W/ckpt"; R="$W/out509"; B="$HOME/lr16/code"
+install -d "$CK" "$R"
+exec >>"$W/run.log" 2>&1
+echo "$(date '+%F %T %Z') start $N"
+snap() {
+  cp -f "$W/run509.time" "$W/hashes.txt" "$W/lscpu.txt" "$CK/" 2>/dev/null
+  tail -n 20 "$W/setup.log" > "$CK/setup.log.tail" 2>/dev/null
+  tail -n 20 "$W/run509.log" > "$CK/run509.log.tail" 2>/dev/null
+  cp -f "$R/ir.jsonl" "$R/km1.json" "$CK/" 2>/dev/null
+  n=$(cat "$R/ir.jsonl" 2>/dev/null | wc -l)
+  of=$(grep -oE '^ir jobs [0-9]+' "$W/run509.log" 2>/dev/null | tail -n 1 | grep -oE '[0-9]+$'); of=${of:-0}
+  printf '{"job":"%s","ir_lines":%s,"of":%s,"time":"%s"}\n' "$N" "$n" "$of" "$(date '+%F %T %Z')" > "$CK/latest.json.tmp" && mv "$CK/latest.json.tmp" "$CK/latest.json"
+}
+if [[ ! -f "$W/build.ok" ]]; then
+  if ! command -v unzip >/dev/null 2>&1; then
+    install -d "$W/bin"; cp "$D/jobs/kit/unzip-shim.py" "$W/bin/unzip"; chmod +x "$W/bin/unzip"; export PATH="$W/bin:$PATH"
+    echo "unzip missing: using jobs/kit/unzip-shim.py"
+  fi
+  bash "$D/jobs/kit/setup_k15.sh" > "$W/setup.log" 2>&1
+  grep -q '^SETUP_OK' "$W/setup.log" || { echo "$(date '+%F %T %Z') setup FAILED"; snap; exit 1; }
+  (cd "$B" && sha256sum bgk15 cascade_k15p cascade_filter_k_patched.cpp) > "$W/hashes.txt"
+  lscpu > "$W/lscpu.txt"
+  date '+%F %T %Z' > "$W/build.ok"
+fi
+cp -f "$D/jobs/kit/kcascade_run.py" "$B/kcascade_run.py"
+now=$(date +%s); dl=$(date -d '2026-11-11 18:00:00 +0800' +%s)
+( while sleep 300; do snap; done ) & SNAP=$!
+cd "$B"
+date '+%F %T %Z' | tee -a "$W/run509.time"
+if (( now < dl )); then
+  echo "BUDGET=$((dl - now))"
+  BUDGET=$((dl - now)) python3 kcascade_run.py ./bgk15 ./cascade_k15p 509 16 "$R" 2>&1 | tee -a "$W/run509.log"
+else
+  echo "no BUDGET"
+  python3 kcascade_run.py ./bgk15 ./cascade_k15p 509 16 "$R" 2>&1 | tee -a "$W/run509.log"
+fi
+rc=${PIPESTATUS[0]}
+date '+%F %T %Z' | tee -a "$W/run509.time"
+kill "$SNAP" 2>/dev/null
+n=$(wc -l < "$R/ir.jsonl" 2>/dev/null || echo 0)
+echo "$(date '+%F %T %Z') kcascade rc=$rc ir_lines=$n"
+snap
+of=$(grep -oE '^ir jobs [0-9]+' "$W/run509.log" 2>/dev/null | tail -n 1 | grep -oE '[0-9]+$'); of=${of:-0}
+echo "$(date '+%F %T %Z') job count from kcascade: of=$of"
+if (( rc == 0 && of > 0 && n >= of )); then date '+%F %T %Z' > "$STATE/$N.done"; echo "DONE $N"; fi
